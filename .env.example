# Copy to ".env" and fill in your OpenAI key and model.
# With no model set, the lab runs with the MOCK policy: it exercises the whole
# pipeline without credentials, is always labelled, and is not a model evaluation.

LLM_PROVIDER=openai
LLM_API_KEY=<your OpenAI key>
LLM_MODEL=<an OpenAI model that supports tool calling, e.g. gpt-5.5>

# Optional
# LLM_TEMPERATURE=0
# Some OpenAI reasoning models only accept tools on this API with reasoning turned off:
# LLM_REASONING_EFFORT=none

# --- Retrieval ----------------------------------------------------------------
# Profiles are embedded with a local hashing embedder by default. To use an
# OpenAI embedding model instead (uses LLM_API_KEY unless EMBEDDING_API_KEY is set):
# EMBEDDING_MODEL=<embedding model name>

# --- Runtime limits and paths (defaults shown) ----------------------------------
# ONTOLAB_MAX_TOOL_CALLS=12
# ONTOLAB_TOOL_TIMEOUT_S=10
# ONTOLAB_RUN_TIMEOUT_S=180
# ONTOLAB_MEMORY_TURNS=6        # conversation turns an agent remembers (0 turns memory off)
# ONTOLAB_MEMORY_TTL_S=3600     # seconds an idle conversation is kept
# ONTOLAB_CASES=2000
# ONTOLAB_SEED=42
# ONTOLAB_DB=runs/ontolab.duckdb
# ONTOLAB_ONTOLOGY=data/ontology/laptop_support.yaml

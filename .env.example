# Copy to ".env". With nothing set, the lab runs with the MOCK model: a fixed policy
# that exercises the whole pipeline without credentials. Mock results are always
# labelled and are not a model evaluation.

# --- Which model answers ------------------------------------------------------
# mock | openai | anthropic | local
# LLM_PROVIDER=mock

# OpenAI, or any OpenAI-compatible API (set LLM_BASE_URL for other providers)
# LLM_PROVIDER=openai
# LLM_API_KEY=<your key>
# LLM_MODEL=<a model that supports tool calling>
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0
# Some OpenAI reasoning models only accept tools on this API with reasoning turned off:
# LLM_REASONING_EFFORT=none

# Anthropic (Claude), through the official SDK
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<your key>
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# A local model through Ollama or LM Studio (no key)
# LLM_PROVIDER=local
# LLM_MODEL=<a local model that supports tool calling>
# LLM_BASE_URL=http://localhost:11434/v1

# --- Retrieval ----------------------------------------------------------------
# Profiles are embedded with a local hashing embedder by default. To use a real
# embedding model on an OpenAI-compatible endpoint, set:
# EMBEDDING_MODEL=<embedding model name>
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=<your key>

# --- Runtime limits and paths (defaults shown) ----------------------------------
# ONTOLAB_MAX_TOOL_CALLS=12
# ONTOLAB_TOOL_TIMEOUT_S=10
# ONTOLAB_RUN_TIMEOUT_S=180
# ONTOLAB_MEMORY_TURNS=6        # conversation turns an agent remembers (0 turns memory off)
# ONTOLAB_MEMORY_TTL_S=3600     # seconds an idle conversation is kept
# ONTOLAB_CASES=2000
# ONTOLAB_SEED=42
# ONTOLAB_DB=runs/ontolab.duckdb
# ONTOLAB_ONTOLOGY=data/ontology/laptop_support.yaml
